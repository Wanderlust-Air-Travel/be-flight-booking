# =============================================================================
# PRODUCTION — Live production server (Docker on VPS)
# be-flight-booking/.env.production
#
# CRITICAL SECURITY NOTES:
#   - Use STRONG random values for ALL secrets
#   - NEVER commit this file to version control
#   - Store secrets in a secure vault (e.g., HashiCorp Vault, AWS Secrets Manager)
#   - Rotate secrets regularly
#
# USAGE:
#   1. cp .env.example .env.production
#   2. Edit all values below with PRODUCTION values
#   3. cp .env.production .env
#   4. docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=flight-booking
VERSION=1.0.0

# ─── Service Ports ────────────────────────────────────────────────────────────
API_GATEWAY_PORT=8080
SEARCH_SERVICE_PORT=8090
BOOKING_SERVICE_PORT=8091
PAYMENT_SERVICE_PORT=8092
GRPC_PORT=50051

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=flightbooking
DB_USER=flightbooking
# Generate with: openssl rand -base64 48
DB_PASSWORD=REPLACE_WITH_YOUR_VERY_LONG_DB_PASSWORD_48_CHARS
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=100
DB_IDLE_CONNECTIONS=20
DB_CONNECTION_LIFETIME=300

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=REPLACE_WITH_YOUR_VERY_LONG_REDIS_PASSWORD
REDIS_DB=0
REDIS_FLIGHT_CACHE_TTL=300
REDIS_SESSION_TTL=900

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=prod_admin
# Generate with: openssl rand -base64 32
RABBITMQ_PASSWORD=REPLACE_WITH_YOUR_VERY_LONG_RABBITMQ_PASSWORD
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=flightbooking.events
RABBITMQ_PREFETCH=10

# ─── Aviationstack API (real production key) ──────────────────────────────────
AVIATIONSTACK_API_KEY=your_real_production_api_key
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
AVIATIONSTACK_TIMEOUT=15
AVIATIONSTACK_RETRY_ATTEMPTS=5
AVIATIONSTACK_CACHE_TTL=300

# ─── Payment (real payment provider) ─────────────────────────────────────────
# Options: stripe | paypal | mock
PAYMENT_PROVIDER=stripe
# NEVER enable mock in production!
PAYMENT_MOCK_ENABLED=false

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_YOUR_VERY_LONG_JWT_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRY_HOURS=1

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com,https://api.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,X-Request-ID
CORS_EXPOSE_HEADERS=X-Total-Count,X-Request-ID
CORS_MAX_AGE=86400

# ─── Rate Limit ───────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=warn
LOG_FORMAT=json
