FROM node:20-alpine

WORKDIR /app

ENV NPM_CONFIG_FETCH_TIMEOUT=120000 \
    NPM_CONFIG_FETCH_RETRIES=3

RUN apk add --no-cache netcat-openbsd

# Install dependencies
COPY package*.json ./
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps

# Copy source code for email service
COPY src-nestjs ./src-nestjs
COPY tsconfig.json tsconfig.build.json nest-cli.json ./

# Copy credentials (build-time secret - only for this service)
COPY credentials_desktop_apps.json token.json ./

# Build all (fast with incremental compilation)
RUN npx nest build

EXPOSE 3000

CMD ["node", "dist/microservices/email/main.email.js"]
