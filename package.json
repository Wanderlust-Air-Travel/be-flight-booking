{
  "name": "be-flight-booking",
  "version": "0.0.1",
  "description": "Flight Booking Backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start --entryFile api-gateway/main",
    "start:dev": "nest start --watch --entryFile api-gateway/main",
    "start:search:dev": "nest start --watch --entryFile microservices/search/main.search",
    "start:services:dev": "nest start --watch --entryFile microservices/services/main.services",
    "start:routes:dev": "nest start --watch --entryFile microservices/routes/main.routes",
    "start:booking:dev": "nest start --watch --entryFile microservices/booking/main.booking",
    "start:reservation:dev": "nest start --watch --entryFile microservices/reservation/main.reservation",
    "start:payment:dev": "nest start --watch --entryFile microservices/payment/main.payment",
    "start:email:dev": "nest start --watch --entryFile microservices/email/main.email",
    "start:all": "ts-node -r tsconfig-paths/register docker/start-all.ts",
    "start:prod": "node dist/api-gateway/main",
    "seed:full": "ts-node -r tsconfig-paths/register src-nestjs/scripts/seed-full-database.ts",
    "sync:flight-data": "ts-node -r tsconfig-paths/register src-nestjs/scripts/sync-flight-data-from-provider.ts",
    "seed:internal-schedule": "ts-node -r tsconfig-paths/register src-nestjs/scripts/seed-internal-schedule.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "migration:generate": "node scripts/run-migration.js generate",
    "migration:run": "node scripts/run-migration.js run",
    "migration:revert": "node scripts/run-migration.js revert",
    "migration:show": "node scripts/run-migration.js show",
    "lint": "biome check src-nestjs/",
    "lint:fix": "biome check --write src-nestjs/",
    "docker:init-db": "node -e \"const {spawnSync}=require('child_process');const r=spawnSync('docker',['compose','-f','docker-compose.infrastructure.development.yml','-f','docker-compose.development.yml','--env-file','.env.development','run','--rm','-e','DB_HOST=sqlserver','api-gateway','npx','ts-node','-r','tsconfig-paths/register','docker/init-database.ts'],{stdio:'inherit',shell:true});process.exit(r.status||1);\"",
    "docker:infra:up": "docker compose -f docker-compose.infrastructure.development.yml --env-file .env.development up -d",
    "docker:infra:down": "docker compose -f docker-compose.infrastructure.development.yml --env-file .env.development down",
    "docker:infra:logs": "docker compose -f docker-compose.infrastructure.development.yml --env-file .env.development logs -f",
    "docker:infra:restart": "docker compose -f docker-compose.infrastructure.development.yml --env-file .env.development restart",
    "docker:dev:build": "docker compose -f docker-compose.infrastructure.development.yml -f docker-compose.development.yml --env-file .env.development build",
    "docker:dev:up": "docker compose -f docker-compose.infrastructure.development.yml -f docker-compose.development.yml --env-file .env.development up -d",
    "docker:dev:down": "docker compose -f docker-compose.infrastructure.development.yml -f docker-compose.development.yml --env-file .env.development down",
    "docker:dev:logs": "docker compose -f docker-compose.infrastructure.development.yml -f docker-compose.development.yml --env-file .env.development logs -f",
    "docker:dev:logs:gateway": "docker compose -f docker-compose.development.yml --env-file .env.development logs -f api-gateway",
    "docker:dev:sync": "npm run build && npm run docker:dev:sync:restart-all",
    "docker:dev:sync:fe": "cd ../fe-flight-booking && npm run build",
    "docker:dev:sync:restart-all": "node scripts/docker-dev-sync.js restart-all",
    "docker:dev:sync:gateway": "node scripts/docker-dev-sync.js restart api-gateway",
    "docker:dev:sync:service": "node scripts/docker-dev-sync.js restart",
    "docker:staging:infra:up": "docker compose -f docker-compose.infrastructure.staging.yml --env-file .env.staging up -d",
    "docker:staging:infra:down": "docker compose -f docker-compose.infrastructure.staging.yml --env-file .env.staging down",
    "docker:staging:infra:logs": "docker compose -f docker-compose.infrastructure.staging.yml --env-file .env.staging logs -f",
    "docker:staging:infra:restart": "docker compose -f docker-compose.infrastructure.staging.yml --env-file .env.staging restart",
    "docker:staging:build": "docker compose -f docker-compose.infrastructure.staging.yml -f docker-compose.staging.yml --env-file .env.staging build",
    "docker:staging:up": "docker compose -f docker-compose.infrastructure.staging.yml -f docker-compose.staging.yml --env-file .env.staging up -d",
    "docker:staging:down": "docker compose -f docker-compose.infrastructure.staging.yml -f docker-compose.staging.yml --env-file .env.staging down",
    "docker:staging:logs": "docker compose -f docker-compose.infrastructure.staging.yml -f docker-compose.staging.yml --env-file .env.staging logs -f",
    "docker:staging:logs:gateway": "docker compose -f docker-compose.staging.yml --env-file .env.staging logs -f api-gateway",
    "docker:prod:infra:up": "docker compose -f docker-compose.infrastructure.prod.yml --env-file .env.prod up -d",
    "docker:prod:infra:down": "docker compose -f docker-compose.infrastructure.prod.yml --env-file .env.prod down",
    "docker:prod:infra:logs": "docker compose -f docker-compose.infrastructure.prod.yml --env-file .env.prod logs -f",
    "docker:prod:infra:restart": "docker compose -f docker-compose.infrastructure.prod.yml --env-file .env.prod restart",
    "docker:prod:build": "docker compose -f docker-compose.infrastructure.prod.yml -f docker-compose.prod.yml --env-file .env.prod build",
    "docker:prod:up": "docker compose -f docker-compose.infrastructure.prod.yml -f docker-compose.prod.yml --env-file .env.prod up -d",
    "docker:prod:down": "docker compose -f docker-compose.infrastructure.prod.yml -f docker-compose.prod.yml --env-file .env.prod down",
    "docker:prod:logs": "docker compose -f docker-compose.infrastructure.prod.yml -f docker-compose.prod.yml --env-file .env.prod logs -f",
    "docker:prod:logs:gateway": "docker compose -f docker-compose.prod.yml --env-file .env.prod logs -f api-gateway",
    "docker:prod:pull": "docker compose -f docker-compose.prod.yml --env-file .env.prod pull",
    "data:sync": "ts-node -r tsconfig-paths/register src-nestjs/scripts/data-cli.ts sync"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.9",
    "@types/amqplib": "^0.10.8",
    "@types/pdfkit": "^0.17.4",
    "amqplib": "^0.10.9",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "googleapis": "^144.0.0",
    "ioredis": "^5.8.2",
    "mssql": "^11.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/mssql": "^4.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.4.5",
    "jest": "^30.0.0",
    "nodemon": "^3.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
