{
  "name": "be-flight-booking",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "start": "nest start --entryFile api-gateway/main",
    "start:dev": "nest start --watch --entryFile api-gateway/main",
    "start:search:dev": "nest start --watch --entryFile microservices/search/main.search",
    "start:services:dev": "nest start --watch --entryFile microservices/services/main.services",
    "start:routes:dev": "nest start --watch --entryFile microservices/routes/main.routes",
    "start:booking:dev": "nest start --watch --entryFile microservices/booking/main.booking",
    "start:reservation:dev": "nest start --watch --entryFile microservices/reservation/main.reservation",
    "start:payment:dev": "nest start --watch --entryFile microservices/payment/main.payment",
    "start:email:dev": "nest start --watch --entryFile microservices/email/main.email",
    "start:all": "ts-node -r tsconfig-paths/register docker/start-all.ts",
    "start:all:prod": "sh docker/start-all-prod.sh",
    "start:prod": "node dist/api-gateway/main",
    "wait-for-sqlserver": "ts-node -r tsconfig-paths/register docker/wait-for-sqlserver.ts",
    "wait-for-rabbitmq": "ts-node -r tsconfig-paths/register docker/wait-for-rabbitmq.ts",
    "init-db": "ts-node -r tsconfig-paths/register docker/init-database.ts",
    "wait-for-db": "ts-node -r tsconfig-paths/register docker/wait-for-database.ts",
    "seed:if-empty": "ts-node -r tsconfig-paths/register docker/seed-if-empty.ts",
    "seed-db": "node dist/scripts/seed-full-database.js",
    "gmail:auth": "ts-node -r tsconfig-paths/register scripts/gmail-auth.ts",
    "seed:full": "ts-node -r tsconfig-paths/register src/scripts/seed-full-database.ts",
    "sync:flight-data": "ts-node -r tsconfig-paths/register src/scripts/sync-flight-data-from-provider.ts",
    "seed:internal-schedule": "ts-node -r tsconfig-paths/register src/scripts/seed-internal-schedule.ts",
    "env:setup": "node -e \"const fs = require('fs'); if (!fs.existsSync('.env')) { fs.copyFileSync('env.example', '.env'); console.log('Created .env file from env.example'); } else { console.log('.env file already exists. Skipping...'); }\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/shared/config/typeorm.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/shared/config/typeorm.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/shared/config/typeorm.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/shared/config/typeorm.ts",
    "docker:up-fix": "node scripts/docker-up-and-fix.js"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.9",
    "@types/amqplib": "^0.10.8",
    "@types/pdfkit": "^0.17.4",
    "amqplib": "^0.10.9",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "googleapis": "^144.0.0",
    "ioredis": "^5.8.2",
    "mssql": "^11.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/mssql": "^4.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
