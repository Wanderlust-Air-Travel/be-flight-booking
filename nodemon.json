{
  "watch": ["src"],
  "ext": "ts,json",
  "ignore": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "node_modules",
    "dist",
    "coverage",
    "*.log",
    "logs",
    ".git",
    ".env",
    "docker",
    "tools",
    "test",
    "*.md",
    "nodemon.json",
    "package.json",
    "package-lock.json",
    "tsconfig.json"
  ],
  "exec": "ts-node -r tsconfig-paths/register",
  "delay": 3000,
  "verbose": false
}

