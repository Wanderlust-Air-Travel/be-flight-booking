# =============================================================================
# STAGING — Staging server deployment (Docker on VPS)
# be-flight-booking/.env.staging
#
# USAGE:
#   docker compose -f docker-compose.yml -f docker-compose.infrastructure.yml -f docker-compose.staging.yml --env-file .env.staging up -d
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=staging
API_GATEWAY_PORT=8080

# ─── SQL Server ──────────────────────────────────────────────────────────────
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=flight_booking_db
DB_USER=sa
# Generate with: openssl rand -base64 24
DB_PASS=CHANGE_ME_staging_password
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ─── RabbitMQ ──────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=staging_admin
# Generate with: openssl rand -base64 24
RABBITMQ_PASSWORD=CHANGE_ME_staging_rabbitmq
RABBITMQ_VHOST=/

# ─── JWT ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_staging_jwt_secret

# ─── Microservices (TCP) ──────────────────────────────────────────────────────
SEARCH_MS_HOST=0.0.0.0
SEARCH_MS_PORT=4001
SERVICES_MS_HOST=0.0.0.0
SERVICES_MS_PORT=4002
ROUTES_MS_HOST=0.0.0.0
ROUTES_MS_PORT=4003
BOOKING_MS_HOST=0.0.0.0
BOOKING_MS_PORT=4004
RESERVATION_MS_HOST=0.0.0.0
RESERVATION_MS_PORT=4005
PAYMENT_MS_HOST=0.0.0.0
PAYMENT_MS_PORT=4006
EMAIL_MS_HOST=0.0.0.0
EMAIL_MS_PORT=4007

# ─── CORS ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── App ───────────────────────────────────────────────────────────────────
APP_URL=https://staging.yourdomain.com
