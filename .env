# ============================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# 
# CÁCH SỬ DỤNG:
# 1. Copy file này thành .env: 
#    - Windows: copy env.example .env
#    - Linux/Mac: cp env.example .env
#    - Hoặc chạy: npm run env:setup
#
# 2. Chỉnh sửa các giá trị trong .env theo môi trường của bạn
#
# 3. File .env sẽ được:
#    - Load bởi docker-compose (cho Docker)
#    - Load bởi app.config.ts (cho local development)
#    - Load bởi test/setup.ts (cho E2E tests)
#
# LƯU Ý:
# - File .env KHÔNG được commit vào git (đã có trong .gitignore)
# - File env.example được commit để làm template
# - Khi chạy Docker, một số biến sẽ được override (xem docker-compose-full-services.yml)
#
# ============================================================

PORT=3000
NODE_ENV=development

# Database
# Note: 
# - Local SQL Server (not Docker): DB_HOST=localhost, DB_PORT=1433 (SQL Server default port)
# - Docker (from host machine): DB_HOST=localhost, DB_PORT=1433 (kết nối đến sqlserver container qua host port)
# - Docker (inside containers): DB_HOST=localhost, DB_PORT=1434 (overridden by docker-compose)
DB_HOST=localhost
DB_PORT=1434
DB_USER=sa
DB_PASS=Passw0rd123!
DB_NAME=flight_booking_db
DB_ENCRYPT=false
DB_TRUST_CERT=true
SA_PASSWORD=Passw0rd123!

# Redis
# Note: When running in Docker, REDIS_HOST is overridden in docker-compose
# - From host: REDIS_HOST=localhost
# - In Docker: REDIS_HOST=redis (container name)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=flight-booking:
REDIS_RESERVATION_TTL=900
REDIS_IDEMPOTENCY_TTL=7200
REDIS_BOOKING_STATE_TTL=1800
REDIS_IDEMPOTENCY_ENABLED=true
RESERVATION_TTL=900
PAYMENT_TTL=900

# JWT
JWT_ACCESS_SECRET=c769850ee4f001088ba440c3211390099dbb7f9e2e0593be9233e395dce6e931
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=1bbf355aefde63bd595ec266351544354991b215124ed1b88ab7c8ef92f876d8
JWT_REFRESH_EXPIRES=7d

# Payment
PAYMENT_EXPIRATION_MINUTES=15

# Dev Payment Gateway
# URL của ứng dụng (dùng cho DevPaymentGateway để tạo paymentUrl)
APP_URL=http://localhost:3001

# API Gateway
FRONTEND_URL=http://localhost:3001

# Microservices
# Note: Microservices host/port have defaults in app.config.ts (127.0.0.1:4001-4007)
# Only override if you need to change them
MS_TIMEOUT=5000
MS_RETRIES=3

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Circuit Breaker
CIRCUIT_BREAKER_TIMEOUT=3000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000