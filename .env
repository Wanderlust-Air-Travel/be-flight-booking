PORT=3000
NODE_ENV=development

# Database
# Note: 
# - Local SQL Server (not Docker): DB_HOST=localhost, DB_PORT=1433 (SQL Server default port)
# - Docker (from host machine): DB_HOST=localhost, DB_PORT=1433 (kết nối đến sqlserver container qua host port)
# - Docker (inside containers): DB_HOST=localhost, DB_PORT=1434 (overridden by docker-compose)
DB_HOST=localhost
DB_PORT=1434
DB_USER=sa
DB_PASS=Passw0rd123!
DB_NAME=flight_booking_db
DB_ENCRYPT=false
DB_TRUST_CERT=true
SA_PASSWORD=Passw0rd123!

# Redis
# Note: When running in Docker, REDIS_HOST is overridden in docker-compose
# - From host: REDIS_HOST=localhost
# - In Docker: REDIS_HOST=redis (container name)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=flight-booking:
REDIS_RESERVATION_TTL=900
REDIS_IDEMPOTENCY_TTL=7200
REDIS_BOOKING_STATE_TTL=1800
REDIS_IDEMPOTENCY_ENABLED=true
RESERVATION_TTL=900
PAYMENT_TTL=900

# RabbitMQ
# Note: When running in Docker, RABBITMQ_HOST is overridden in docker-compose
# - From host: RABBITMQ_HOST=localhost
# - In Docker: RABBITMQ_HOST=rabbitmq (container name)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_EMAIL=email_notifications
RABBITMQ_QUEUE_TICKETS=ticket_creation
RABBITMQ_EXCHANGE_EVENTS=flight_booking_events
RABBITMQ_PREFETCH_COUNT=10

# JWT
JWT_ACCESS_SECRET=c769850ee4f001088ba440c3211390099dbb7f9e2e0593be9233e395dce6e931
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=1bbf355aefde63bd595ec266351544354991b215124ed1b88ab7c8ef92f876d8
JWT_REFRESH_EXPIRES=7d

# Payment
PAYMENT_EXPIRATION_MINUTES=15

# Dev Payment Gateway
# URL của ứng dụng (dùng cho DevPaymentGateway để tạo paymentUrl)
APP_URL=http://localhost:3001

# API Gateway
FRONTEND_URL=http://localhost:3001

# Microservices
# Note: Microservices host/port have defaults in app.config.ts (127.0.0.1:4001-4007)
# Only override if you need to change them
# For Docker: Set HOST=0.0.0.0 to bind to all interfaces (see docker-compose.yml)
SEARCH_MS_HOST=127.0.0.1
SEARCH_MS_PORT=4001
SERVICES_MS_HOST=127.0.0.1
SERVICES_MS_PORT=4002
ROUTES_MS_HOST=127.0.0.1
ROUTES_MS_PORT=4003
BOOKING_MS_HOST=127.0.0.1
BOOKING_MS_PORT=4004
RESERVATION_MS_HOST=127.0.0.1
RESERVATION_MS_PORT=4005
PAYMENT_MS_HOST=127.0.0.1
PAYMENT_MS_PORT=4006
EMAIL_MS_HOST=127.0.0.1
EMAIL_MS_PORT=4007
MS_TIMEOUT=5000
MS_RETRIES=3

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Circuit Breaker
CIRCUIT_BREAKER_TIMEOUT=3000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000