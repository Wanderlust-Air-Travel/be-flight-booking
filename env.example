# ============================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# 
# CÁCH SỬ DỤNG:
# 1. Copy file này thành .env: 
#    - Windows: copy env.example .env
#    - Linux/Mac: cp env.example .env
#    - Hoặc chạy: npm run env:setup
#
# 2. Chỉnh sửa các giá trị trong .env theo môi trường của bạn
#
# 3. File .env sẽ được:
#    - Load bởi docker-compose (cho Docker)
#    - Load bởi app.config.ts (cho local development)
#    - Load bởi test/setup.ts (cho E2E tests)
#
# LƯU Ý:
# - File .env KHÔNG được commit vào git (đã có trong .gitignore)
# - File env.example được commit để làm template
# - Khi chạy Docker, một số biến sẽ được override (xem docker-compose-full-services.yml)
#
# ============================================================

PORT=3000
NODE_ENV=development

# Database
# Note: 
# - Local SQL Server (not Docker): DB_HOST=localhost, DB_PORT=1433 (SQL Server default port)
# - Docker infrastructure (separate): DB_HOST=localhost, DB_PORT=1434 (mapped in docker-compose.infrastructure.yml)
DB_HOST=localhost
DB_PORT=1434
DB_USER=sa
DB_PASS=Passw0rd123!
DB_NAME=flight_booking_db
DB_ENCRYPT=false
DB_TRUST_CERT=true
SA_PASSWORD=Passw0rd123!

# Redis
# Note: Using separate docker-compose.infrastructure.yml
# - REDIS_HOST is set in .env file (loaded by all services)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=flight-booking:
REDIS_RESERVATION_TTL=900
REDIS_IDEMPOTENCY_TTL=7200
REDIS_BOOKING_STATE_TTL=1800
REDIS_IDEMPOTENCY_ENABLED=true
RESERVATION_TTL=900
PAYMENT_TTL=900

# RabbitMQ
# Note: Using separate docker-compose.infrastructure.yml
# - RABBITMQ_HOST is set in .env file (loaded by all services)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_EMAIL=email_notifications
RABBITMQ_QUEUE_TICKETS=ticket_creation
RABBITMQ_EXCHANGE_EVENTS=flight_booking_events
RABBITMQ_PREFETCH_COUNT=10

# JWT
JWT_ACCESS_SECRET=c769850ee4f001088ba440c3211390099dbb7f9e2e0593be9233e395dce6e931
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=1bbf355aefde63bd595ec266351544354991b215124ed1b88ab7c8ef92f876d8
JWT_REFRESH_EXPIRES=7d

# Payment
PAYMENT_EXPIRATION_MINUTES=15

# Dev Payment Gateway
# URL của ứng dụng (dùng cho DevPaymentGateway để tạo paymentUrl)
APP_URL=http://localhost:3001

# API Gateway
FRONTEND_URL=http://localhost:3001

# Microservices
# Note: Microservices host/port are set in .env and loaded by docker-compose.yml
# - 127.0.0.1: Bind to localhost only (for local/native Node.js development)
# - 0.0.0.0: Bind to all interfaces (for Docker container to accept host connections)
# For Docker backend: Set all MS_HOST to 0.0.0.0
SEARCH_MS_HOST=127.0.0.1
SEARCH_MS_PORT=4001
SERVICES_MS_HOST=127.0.0.1
SERVICES_MS_PORT=4002
ROUTES_MS_HOST=127.0.0.1
ROUTES_MS_PORT=4003
BOOKING_MS_HOST=127.0.0.1
BOOKING_MS_PORT=4004
RESERVATION_MS_HOST=127.0.0.1
RESERVATION_MS_PORT=4005
PAYMENT_MS_HOST=127.0.0.1
PAYMENT_MS_PORT=4006
EMAIL_MS_HOST=127.0.0.1
EMAIL_MS_PORT=4007
MS_TIMEOUT=5000
MS_RETRIES=3

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Circuit Breaker
CIRCUIT_BREAKER_TIMEOUT=3000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Amadeus for Developers (flight data provider – free tier)
# Đăng ký miễn phí: https://developers.amadeus.com → Create account → My Self-Service APIs → Create new app
# Cần cho script sync chuyến bay: npm run sync:flight-data
# AMADEUS_CLIENT_ID=your_api_key
# AMADEUS_CLIENT_SECRET=your_api_secret