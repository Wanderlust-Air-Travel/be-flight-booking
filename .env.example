# =============================================================================
# Flight Booking Backend — Environment Variables Template
# be-flight-booking/.env.example
#
# IMPORTANT: This file is a REFERENCE ONLY.
#            Create separate .env files for each environment:
#              - .env.development  (local native dev)
#              - .env.staging      (staging server)
#              - .env.production   (production server)
#
# USAGE:
#   Development: cp .env.example .env.development && cp .env.development .env
#   Staging:     cp .env.example .env.staging && cp .env.staging .env
#   Production:  cp .env.example .env.production && cp .env.production .env
#
# Then edit each .env.* file and set appropriate values per environment.
# =============================================================================

# =============================================================================
# SECTION 1: APPLICATION
# =============================================================================
APP_ENV=development
APP_NAME=flight-booking
VERSION=1.0.0

# =============================================================================
# SECTION 2: SERVICE PORTS
# =============================================================================
API_GATEWAY_PORT=8080
SEARCH_SERVICE_PORT=8090
BOOKING_SERVICE_PORT=8091
PAYMENT_SERVICE_PORT=8092
GRPC_PORT=50051

# =============================================================================
# SECTION 3: POSTGRESQL
# =============================================================================
# Development (native): DB_HOST=localhost
# Docker:               DB_HOST=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flightbooking
DB_USER=flightbooking
# IMPORTANT: Use a strong random password in staging/production
# Generate with: openssl rand -base64 48
DB_PASSWORD=flightbooking123
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_IDLE_CONNECTIONS=5
DB_CONNECTION_LIFETIME=300

# =============================================================================
# SECTION 4: REDIS
# =============================================================================
# Development (native): REDIS_HOST=localhost
# Docker:               REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_FLIGHT_CACHE_TTL=900
REDIS_SESSION_TTL=3600

# =============================================================================
# SECTION 5: RABBITMQ
# =============================================================================
# Development (native): RABBITMQ_HOST=localhost
# Docker:               RABBITMQ_HOST=rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# IMPORTANT: Use strong credentials in staging/production
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=flightbooking.events
RABBITMQ_PREFETCH=10

# =============================================================================
# SECTION 6: AVIATIONSTACK API
# Get free key at: https://aviationstack.com
# =============================================================================
AVIATIONSTACK_API_KEY=your_api_key_here
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
AVIATIONSTACK_TIMEOUT=10
AVIATIONSTACK_RETRY_ATTEMPTS=3
AVIATIONSTACK_CACHE_TTL=900

# =============================================================================
# SECTION 7: PAYMENT
# =============================================================================
# Options: mock | stripe | paypal
PAYMENT_PROVIDER=mock
# Development/Staging: true (no real charges)
# Production:          false (real charges)
PAYMENT_MOCK_ENABLED=true

# =============================================================================
# SECTION 8: JWT AUTHENTICATION
# =============================================================================
# IMPORTANT: Use a STRONG random secret in staging/production
# Generate with: openssl rand -base64 64
JWT_SECRET=change_me_in_production_use_strong_random_32chars
JWT_EXPIRY_HOURS=24

# =============================================================================
# SECTION 9: CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Development: local FE URLs
# Staging:     staging domain
# Production:  production domain (HTTPS only)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,X-Request-ID
CORS_EXPOSE_HEADERS=X-Total-Count,X-Request-ID
CORS_MAX_AGE=86400

# =============================================================================
# SECTION 10: RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# =============================================================================
# SECTION 11: LOGGING
# =============================================================================
# Options: debug | info | warn | error
LOG_LEVEL=debug
LOG_FORMAT=json
