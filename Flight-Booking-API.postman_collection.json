{
	"info": {
		"_postman_id": "flight-booking-api-collection",
		"name": "Flight Booking API",
		"description": "Collection để test Flight Booking API trên Postman\n\n**Lưu ý:**\n- Chạy `npm run seed:full` trước khi test\n- Seed tạo data cho 60 ngày tới (từ hôm nay)\n- Có 500 users, 300-450 schedules, 50 schedules được xử lý để tạo instances\n- Dates trong requests cần nằm trong khoảng 60 ngày từ hôm nay",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Search",
			"item": [
				{
					"name": "Search Flights - One Way (HAN → SGN)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/search/flights?origin=HAN&destination=SGN&departDate={{departDate}}&tripType=one_way&adults=1&minors=0",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"search",
								"flights"
							],
							"query": [
								{
									"key": "origin",
									"value": "HAN",
									"description": "Origin airport IATA code"
								},
								{
									"key": "destination",
									"value": "SGN",
									"description": "Destination airport IATA code"
								},
								{
									"key": "departDate",
									"value": "{{departDate}}",
									"description": "Departure date (YYYY-MM-DD). Phải nằm trong khoảng 60 ngày từ hôm nay (sau khi seed)"
								},
								{
									"key": "tripType",
									"value": "one_way",
									"description": "Trip type: one_way or round_trip"
								},
								{
									"key": "adults",
									"value": "1",
									"description": "Number of adult passengers"
								},
								{
									"key": "minors",
									"value": "0",
									"description": "Number of minor passengers"
								}
							]
						},
						"description": "Search for one-way flights from Hanoi to Ho Chi Minh City"
					},
					"response": []
				},
