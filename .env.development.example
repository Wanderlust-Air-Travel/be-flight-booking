# =============================================================================
# DEVELOPMENT — Local Docker deployment
# be-flight-booking/.env.development
#
# Architecture:
#   - Infrastructure: docker-compose.infrastructure.development.yml
#   - Application:    docker-compose.development.yml
#   - Both share THIS env file.
#
# USAGE:
#   # 1) Start infrastructure only (sqlserver, redis, rabbitmq):
#   docker compose -f docker-compose.infrastructure.development.yml \
#     --env-file .env.development up -d
#
#   # 2) Start application services (infrastructure must be running):
#   docker compose -f docker-compose.development.yml \
#     --env-file .env.development up -d
#
#   # 3) Start full stack (infra + app) in one command:
#   docker compose -f docker-compose.infrastructure.development.yml \
#     -f docker-compose.development.yml \
#     --env-file .env.development up -d
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_GATEWAY_PORT=3000

# ─── SQL Server (Docker service) ──────────────────────────────────────────────
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=flight_booking_db
DB_USER=sa
DB_PASS=StrongPass1234
DB_ENCRYPT=true
DB_TRUST_CERT=true

# ─── Redis (Docker service) ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ─── RabbitMQ (Docker service) ──────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ─── JWT (dev only) ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev_secret_change_before_production

# ─── Microservices (TCP) ──────────────────────────────────────────────────────
SEARCH_MS_HOST=0.0.0.0
SEARCH_MS_PORT=4001
SERVICES_MS_HOST=0.0.0.0
SERVICES_MS_PORT=4002
ROUTES_MS_HOST=0.0.0.0
ROUTES_MS_PORT=4003
BOOKING_MS_HOST=0.0.0.0
BOOKING_MS_PORT=4004
RESERVATION_MS_HOST=0.0.0.0
RESERVATION_MS_PORT=4005
PAYMENT_MS_HOST=0.0.0.0
PAYMENT_MS_PORT=4006
EMAIL_MS_HOST=0.0.0.0
EMAIL_MS_PORT=4007

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── App ───────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3001

# ─── Email (Gmail OAuth2) ─────────────────────────────────────────────────────
# Optional but required for real email delivery.
# If omitted, the email microservice will start but stay unhealthy (`gmailReady=false`)
# and all queued emails will fail after retries.
GMAIL_CREDENTIALS_PATH=./credentials_desktop_apps.json
GMAIL_TOKEN_PATH=./token.json
GMAIL_FROM_EMAIL=nmax4115@gmail.com
