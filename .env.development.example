# =============================================================================
# DEVELOPMENT — Local native development (no Docker for services)
# be-flight-booking/.env.development
#
# USAGE:
#   1. cp .env.example .env.development
#   2. cp .env.development .env
#   3. Run services natively with: go run ./apps/api-gateway
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=flight-booking
VERSION=1.0.0

# ─── Service Ports ────────────────────────────────────────────────────────────
API_GATEWAY_PORT=8080
SEARCH_SERVICE_PORT=8090
BOOKING_SERVICE_PORT=8091
PAYMENT_SERVICE_PORT=8092
GRPC_PORT=50051

# ─── PostgreSQL (native install — DB_HOST=localhost) ─────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flightbooking
DB_USER=flightbooking
DB_PASSWORD=flightbooking123
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_IDLE_CONNECTIONS=5
DB_CONNECTION_LIFETIME=300

# ─── Redis (native install — REDIS_HOST=localhost) ────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_FLIGHT_CACHE_TTL=900
REDIS_SESSION_TTL=3600

# ─── RabbitMQ (native install — RABBITMQ_HOST=localhost) ─────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=flightbooking.events
RABBITMQ_PREFETCH=10

# ─── Aviationstack API ─────────────────────────────────────────────────────────
AVIATIONSTACK_API_KEY=your_dev_api_key_here
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
AVIATIONSTACK_TIMEOUT=10
AVIATIONSTACK_RETRY_ATTEMPTS=3
AVIATIONSTACK_CACHE_TTL=900

# ─── Payment ───────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_ENABLED=true

# ─── JWT ─────────────────────────────────────────────────────────────────────
# WARNING: Weak secret — dev only
JWT_SECRET=dev_secret_change_before_production
JWT_EXPIRY_HOURS=24

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,X-Request-ID
CORS_EXPOSE_HEADERS=X-Total-Count,X-Request-ID
CORS_MAX_AGE=86400

# ─── Rate Limit ───────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json
