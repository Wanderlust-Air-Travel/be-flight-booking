FROM node:20-alpine

WORKDIR /app

ENV NPM_CONFIG_FETCH_TIMEOUT=120000 \
    NPM_CONFIG_FETCH_RETRIES=3

RUN apk add --no-cache netcat-openbsd

# Install dependencies (includes devDependencies for runtime - NestJS uses them at runtime)
COPY package*.json ./
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps

# Copy pre-built dist folder (TypeScript build was done locally)
COPY dist/ ./dist/

# Create public directory for uploads
RUN mkdir -p public/images/routes

EXPOSE 3000

# Healthcheck for API Gateway
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/api/v1/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Default command (will be overridden by docker-compose)
CMD ["node", "dist/api-gateway/main.js"]
